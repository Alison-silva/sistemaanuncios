	<queryString language="SQL">
		<![CDATA[SELECT 
    a.id, 
    a.preco, 
    a.titulo, 
    a.categoria_id, 
    c.nomecategoria AS nome_da_categoria,
    u.nome AS nome_anunciante
FROM 
    anuncio a
INNER JOIN 
    usuario u ON a.usuario_id = u.id
INNER JOIN 
    categoria c ON a.categoria_id = c.id
ORDER BY 
    a.id ASC;]]>
	</queryString>
